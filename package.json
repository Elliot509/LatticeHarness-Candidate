{
  "name": "lattice-harness",
  "version": "0.0.0",
  "description": "Lattice local-first agent harness runtime (development placeholder name)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "lattice": "./dist/cli/main.js"
  },
  "files": [
    "dist/cli",
    "dist/config.js",
    "dist/context",
    "dist/desktop",
    "dist/platform",
    "dist/productConfig.js",
    "dist/providers",
    "dist/runtime",
    "dist/server",
    "dist/storage",
    "dist/telemetry",
    "dist/tools",
    "dist/ui",
    "desktop/PORTABLE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-ui.mjs && node scripts/build-desktop.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "pack:test": "node scripts/pack-test.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.9",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.5.1",
    "electron-builder": "^26.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.28.2": true
  }
}
