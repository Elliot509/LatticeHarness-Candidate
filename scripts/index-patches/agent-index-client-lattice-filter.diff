+def _agentsview_agents():
+    """Agent names the agentsview query is restricted to, if any.
+
+    Read from AGENT_INDEX_AGENTS (comma-separated). Unset means the historic
+    behaviour: whatever agentsview covers. A harness that must attribute only
+    its own usage sets this to its own agent name so other agents sharing the
+    index can never leak into its report."""
+    return [name for name in (part.strip() for part in
+            os.environ.get("AGENT_INDEX_AGENTS", "").split(",")) if name]
+
+
+def _agentsview_argv(exe):
+    argv = [exe, "usage", "daily", "--json"]
+    for name in _agentsview_agents():
+        argv += ["--agent", name]
+    return argv
+
+
+def _parse_agentsview_output(completed):
+    """Collector rows from a finished agentsview run, or {} with a recorded
+    failure. A non-zero exit is a failure even when stdout still parses:
+    trusting the JSON alone let a broken agentsview publish whatever partial
+    output it managed before dying."""
+    if completed.returncode != 0:
+        FAILURES.append(f"agentsview: exit {completed.returncode}: "
+                        f"{(completed.stderr or '').strip()[:300]}")
+        return []
+    try:
+        rows = json.loads(completed.stdout)
+    except Exception as e:
+        FAILURES.append(f"agentsview: {type(e).__name__}: {e}")
+        return []
+    return rows if isinstance(rows, list) else rows.get("daily") or rows.get("data") or []
+
